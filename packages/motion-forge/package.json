{
  "name": "motion-forge",
  "version": "0.2.0",
  "description": "Interactive animations as plain text. Motion SVG = SVG + a JSON state machine that coding agents write, check and preview, and a tiny runtime plays anywhere.",
  "type": "module",
  "license": "MIT",
  "author": "Bilal Tahir",
  "homepage": "https://motion-forge-dev.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btahir/motion-forge.git",
    "directory": "packages/motion-forge"
  },
  "bugs": "https://github.com/btahir/motion-forge/issues",
  "sideEffects": [
    "./dist/element.js",
    "./dist/browser.global.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": "./dist/browser.global.js",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "motion-forge": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "presets",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gifenc": "^1.0.3",
    "zod": "^4.3.0"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0"
  },
  "keywords": [
    "animation",
    "svg",
    "motion",
    "interactive",
    "state-machine",
    "lottie-alternative",
    "rive-alternative",
    "web-component",
    "react",
    "ai-agents",
    "mcp",
    "claude-code",
    "cursor"
  ],
  "engines": {
    "node": ">=22"
  },
  "unpkg": "./dist/browser.global.js",
  "jsdelivr": "./dist/browser.global.js"
}
